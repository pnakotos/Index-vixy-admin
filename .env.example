# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side secret).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://vhixy.site"

# VIXY WEB PRODUCTION & APP INTERCONNECTION CONFIGURATION
VIXY_BACKEND_API_URL="https://vhixy.site"
VIXY_PROD_API_KEY="YOUR_VIXY_PROD_API_KEY_HERE"
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"
PAYMENT_WEBHOOK_SECRET="YOUR_PAYMENT_WEBHOOK_SECRET_HERE"
DRIVER_APP_SYNC_ENDPOINT="https://vhixy.site/v1/drivers/sync"
PASSENGER_APP_SYNC_ENDPOINT="https://vhixy.site/v1/passengers/sync"
FIREBASE_FCM_KEY="YOUR_FIREBASE_FCM_SERVER_KEY_HERE"
NODE_ENV="production"
