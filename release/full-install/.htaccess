<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # La API PHP vive en public_html/api y no debe recibir el fallback de la SPA.
  RewriteRule ^api(?:/|$) - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
